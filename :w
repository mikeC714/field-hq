@import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

:root {
	--orange: #eea12d;
	--bg-left: #141414;
	--bg-right: #0d0d0d;
	--border:  #4d4b4ba2;
	--text: #f0f0f0;
	--text-muted: #888;
	--input-bg: #1e1e1e;
	--font: "Montserrat", sans-serif;
	--skin:    #2a2a2a;
	--stroke:  var(--orange);
	--mid:     #1e1e1e;
	--signbg:  #111111;
	--font: 'Montserrat', sans-serif;
}

.createQuotePage{
	height:100vh;
	display:grid;
	grid-template-rows:auto 1fr;
	background:var(--bg-right);
}
.createQuoteNav{
	grid-row:1;
	width:100%;
	padding:.6em;
	display:flex;
	justify-content:space-between;
	align-items:center;
	height:fit-content;
	background:var(--bg-left);
}
.cqNavLeft{
	display:flex;
	justify-content:center;
	align-items:center;
	margin-left:16px;
}
.navLogo{
	display:flex;
	justify-content:center;
	align-items:center;
}
.cqNavRight{
	width:18%;
	display:flex;
	align-items:center;
	justify-content:space-evenly;
	padding-right:2%;
}
.quoteStatusSelect{
	height:3em;
	width:10em;
	padding-left:10px;
	border-radius:8px;
	border:1px solid var(--border);
	font-family:var(--font);
	font-size:13px;
	font-weight:400;
	background:transparent;
	cursor:pointer;
}
.cqSendQuoteBtn{
	height:3em;
	padding-right:14px;
	padding-left:14px;
	border:none;
	background-color:var(--orange);
	border-radius:10px;
	text-align:center;
	cursor:pointer;
	transition: opacity 1s ease;
	font-weight:440;
	font-family:var(--font);
}
.cqSendQuoteBtn:hover{
	opacity:.8;	
}
.createQuoteContent{
	display:grid;
	grid-template: auto auto/ .70fr auto
}
.cqLeft{
	grid-column:1;
	grid-row:1/3;
	height:100%;
	display:flex;
	justify-content:center;
	align-items:center;
}
.cqFormWrapper{
	flex:1;
	height:100%;
	width:100%;
	padding:20px;
	display:grid;
	grid-template-rows:repeat(3,auto);
}
.cqCardLabel{
	padding:10px;
}
.cqCustomerCard{
	background:var(--bg-left);
	align-self:center;
	justify-self:center;
	height:80%;
	width:100%;
	border-radius:10px;
	font-family:var(--font);
	font-size:13px;
	letter-spacing:4%;
	display:grid;
	grid-template-rows: auto 1fr;
}
.cqCustomerFields{
	align-self:center;
	justify-self:center;
	width:90%;
	height:100%;
	display:grid;
	align-items:center;
	grid-template-rows:repeat(3,auto);
}
.cqCustomerNames{
	grid-row:1;
	width:100%;
	display:flex;
	gap:20px;
}
.cqCustomerContact{
	display:flex;
	gap:20px;
}
.cqCustomerFields > input{
	align-self:center;
	justify-self:center;
}
.cqInput{
	height:2.4em;
	border-radius:8px;
	border:1px solid var(--border);
	width:86%;
	padding-left:10px;
	outline:1px solid transparent;
	box-sizing:border-box;
	transition:outline-color .1s ease;
}
.cqInput:focus{
	border:none;
	outline:1px solid var(--orange);
}
.cqColSmall{
	width:16%;
	text-align:center;
	padding:0;
}
input::-webkit-outer-spin-button,
input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
input[type=number] {
  -moz-appearance: textfield;
  appearance: textfield;
}
.cqSection{
	border-radius:10px;
	min-height:fit-content;
	height:auto;
	margin:0;
	display:flex;	
	flex-direction:column;
	background-color:var(--bg-left);
}
.cqTable{
	display:flex;
	flex-direction:column;
}
.cqTableHeader{
	width:98%;
	display:grid;
	grid-template-columns:repeat(2,auto);
}
.cqColSmallContainer{
	grid-column:2;
	width:60%;
	justify-self:flex-end;
	align-self:center;
	display:grid;
	grid-template-columns:.4fr .2fr auto;
	column-gap:16px;
	align-items:center;
}
.cqColSmallTitle{
	font-family:var(--font);
	font-size:14px;
}
.cqColSmallQty{
	padding-right:22px;
	justify-self:flex-end;	
}
.cqTableRow{
	position:relative;
	display:flex;
	gap:20px;
}
.cqSmallContainer{
	display:flex;
	gap:20px;
}
.cqTableRow > button{
	position:absolute;
	right:2%;
}


